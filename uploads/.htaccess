# ============================================================
# Block ALL direct web access to uploaded documents. These contain
# sensitive KYC data (selfies, government ID, proof of address) and
# must only ever be served through admin/view_document.php, which
# checks for an authenticated admin session before streaming a file.
#
# This requires AllowOverride to include "Limit" or "All" for this
# directory in your Apache config (XAMPP's default httpd-vhosts.conf
# usually already allows this for htdocs — verify with a direct test:
# a URL like /logistics/uploads/kyc/selfies/anything.jpg should return
# 403 Forbidden, not the file).
# ============================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (legacy fallback)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
